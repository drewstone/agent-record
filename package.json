{
  "name": "@drewstone/agent-record",
  "version": "0.2.1",
  "description": "React viewer for agent conversations, tool execution, topology, and recorded usage.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drewstone/agent-record.git"
  },
  "homepage": "https://drewstone.github.io/agent-record/",
  "bugs": "https://github.com/drewstone/agent-record/issues",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "tools/render-report.mjs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./record": {
      "types": "./dist/record.d.ts",
      "import": "./dist/record.js"
    },
    "./adapters/research-publication": {
      "types": "./dist/adapters/research-publication.d.ts",
      "import": "./dist/research-publication.js"
    },
    "./styles.css": "./dist/styles.css",
    "./report": {
      "types": "./dist/report.d.ts",
      "import": "./dist/report.js"
    }
  },
  "scripts": {
    "dev": "vite --config examples/react/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p examples/react/tsconfig.json --noEmit",
    "build": "vite build && tsc --emitDeclarationOnly && node tools/copy-styles.mjs && node tools/build-standalone.mjs",
    "build:example": "vite build --config examples/react/vite.config.ts",
    "prepack": "pnpm build",
    "test": "node --test tests/*.test.mjs",
    "report": "node tools/render-report.mjs"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20",
    "react-dom": ">=18.3.0 <20"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.2",
    "typescript": "7.0.2",
    "@types/node": "^24.0.0"
  },
  "packageManager": "pnpm@10.23.0",
  "bin": {
    "agent-record-report": "tools/render-report.mjs"
  }
}
