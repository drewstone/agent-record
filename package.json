{
  "name": "@drewstone/agent-record",
  "version": "0.88.3",
  "description": "React viewer for agent conversations, tool execution, topology, and recorded usage.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drewstone/agent-record.git"
  },
  "homepage": "https://drewstone.github.io/agent-record/",
  "bugs": "https://github.com/drewstone/agent-record/issues",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "tools/render-report.mjs",
    "tools/ingest.mjs",
    "tools/activity"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./record": {
      "types": "./dist/record.d.ts",
      "import": "./dist/record.js"
    },
    "./adapters/research-publication": {
      "types": "./dist/adapters/research-publication.d.ts",
      "import": "./dist/research-publication.js"
    },
    "./styles.css": "./dist/styles.css",
    "./report": {
      "types": "./dist/report.d.ts",
      "import": "./dist/report.js"
    },
    "./adapters/agent-runtime": {
      "types": "./dist/adapters/agent-runtime.d.ts",
      "import": "./dist/agent-runtime.js"
    },
    "./adapters/harness-sessions": {
      "types": "./dist/adapters/harness-sessions.d.ts",
      "import": "./dist/harness-sessions.js"
    },
    "./adapters/trace-spans": {
      "types": "./dist/adapters/trace-spans.d.ts",
      "import": "./dist/trace-spans.js"
    },
    "./publication": {
      "types": "./dist/publication.d.ts",
      "import": "./dist/publication.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js"
    },
    "./assessment": {
      "types": "./dist/assessment.d.ts",
      "import": "./dist/assessment.js"
    },
    "./schemas/*": "./dist/schemas/*",
    "./receipt": {
      "types": "./dist/receipt.d.ts",
      "import": "./dist/receipt.js"
    }
  },
  "scripts": {
    "dev": "vite --config examples/react/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p examples/react/tsconfig.json --noEmit",
    "build": "vite build && tsc --emitDeclarationOnly && node tools/copy-styles.mjs && node tools/build-standalone.mjs && node tools/export-schemas.mjs",
    "build:example": "vite build --config examples/react/vite.config.ts",
    "prepack": "pnpm build",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "report": "node tools/render-report.mjs",
    "ingest": "node tools/ingest.mjs"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20",
    "react-dom": ">=18.3.0 <20"
  },
  "dependencies": {
    "@nanostores/react": "^2.0.1",
    "@tangle-network/agent-interface": "5.7.1",
    "@tangle-network/brand": "1.26.2",
    "@tangle-network/charts": "0.20.1",
    "@tangle-network/harness-sessions": "0.1.0",
    "@tangle-network/sandbox-ui": "0.137.1",
    "@tangle-network/ui": "11.42.0",
    "@xterm/addon-fit": "~0.11.0",
    "@xterm/addon-web-links": "~0.12.0",
    "@xterm/addon-webgl": "~0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "elkjs": "~0.12.0",
    "katex": "^0.19.0",
    "nanostores": "^1.5.5",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "packageManager": "pnpm@10.23.0",
  "bin": {
    "agent-record-report": "tools/render-report.mjs",
    "agent-record-ingest": "tools/ingest.mjs"
  }
}
