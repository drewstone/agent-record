{
  "name": "@drewstone/agent-record",
  "version": "3.0.4",
  "description": "Validated agent records, research reports, harness adapters, ingest and standalone report exports.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drewstone/agent-record.git"
  },
  "homepage": "https://drewstone.github.io/agent-record/",
  "bugs": "https://github.com/drewstone/agent-record/issues",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "tools/render-report.mjs",
    "tools/ingest.mjs",
    "tools/activity"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./record": {
      "types": "./dist/record.d.ts",
      "import": "./dist/record.js"
    },
    "./adapters/research-publication": {
      "types": "./dist/adapters/research-publication.d.ts",
      "import": "./dist/research-publication.js",
      "default": "./dist/research-publication.js"
    },
    "./report": {
      "types": "./dist/report.d.ts",
      "import": "./dist/report.js"
    },
    "./adapters/agent-runtime": {
      "types": "./dist/adapters/agent-runtime.d.ts",
      "import": "./dist/agent-runtime.js",
      "default": "./dist/agent-runtime.js"
    },
    "./adapters/harness-sessions": {
      "types": "./dist/adapters/harness-sessions.d.ts",
      "import": "./dist/harness-sessions.js",
      "default": "./dist/harness-sessions.js"
    },
    "./adapters/trace-spans": {
      "types": "./dist/adapters/trace-spans.d.ts",
      "import": "./dist/trace-spans.js",
      "default": "./dist/trace-spans.js"
    },
    "./publication": {
      "types": "./dist/publication.d.ts",
      "import": "./dist/publication.js"
    },
    "./workspace": {
      "types": "./dist/workspace-model.d.ts",
      "import": "./dist/workspace.js",
      "default": "./dist/workspace.js"
    },
    "./assessment": {
      "types": "./dist/assessment.d.ts",
      "import": "./dist/assessment.js"
    },
    "./schemas/*": "./dist/schemas/*"
  },
  "scripts": {
    "dev": "vite --config examples/react/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p examples/react/tsconfig.json --noEmit",
    "build": "vite build && tsc --emitDeclarationOnly && node tools/export-schemas.mjs",
    "build:example": "vite build --config examples/react/vite.config.ts",
    "prepack": "pnpm build",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "report": "node tools/render-report.mjs",
    "ingest": "node tools/ingest.mjs"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20",
    "react-dom": ">=18.3.0 <20"
  },
  "dependencies": {
    "@tangle-network/charts": "^4.0.1",
    "@tangle-network/harness-sessions": "^0.1.0",
    "@tangle-network/sandbox-ui": "^3.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@drewstone/agent-record": "link:.",
    "@tangle-network/brand": "^1.31.3",
    "@tangle-network/ui": "^11.51.7",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "^1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "packageManager": "pnpm@10.23.0",
  "bin": {
    "agent-record-report": "tools/render-report.mjs",
    "agent-record-ingest": "tools/ingest.mjs"
  }
}
