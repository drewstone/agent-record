{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@drewstone/agent-record": [
        "../../src/index.ts"
      ],
      "@drewstone/agent-record/adapters/*": [
        "../../src/adapters/*.ts"
      ],
      "@drewstone/agent-record/record": [
        "../../src/record.ts"
      ]
    }
  },
  "include": [
    "src.tsx",
    "vite.config.ts"
  ]
}
